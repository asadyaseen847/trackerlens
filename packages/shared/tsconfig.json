{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Shared code runs in browsers and Node: the DOM lib provides URL / URLSearchParams typings
    // (both runtimes have them). Node types are for the tests (fs, import.meta.url).
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["src", "test", "tsup.config.ts"]
}
