# Copy to apps/web/.env for local development. Never commit the real file.

# Base path of the API. "/api" goes through the Vite dev proxy locally and the Vercel rewrite in production.
VITE_API_URL=/api

# Collect URL baked into public/js/script.js by `npm run build:tracker` (read by packages/tracker/build.mjs).
# Defaults to http://localhost:4000/api/e when unset.
TRACKER_API_URL=https://trackerlens-api.vercel.app/api/e

# Domains that show only the "opening soon" waitlist page instead of the app (comma-separated).
# Default when unset: traffic.rankbid.click
VITE_COMING_SOON_HOSTS=
