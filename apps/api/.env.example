# Copy to apps/api/.env for local development. Never commit the real file.

# Supabase project URL and service-role key (required, also in development).
# Supabase dashboard → Project Settings → API. On Vercel the Supabase integration sets both.
# The service-role key bypasses row level security: server-side only, never in the web app.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign the login JWT cookie. Long random string. Required in production.
JWT_SECRET=

# 32 random bytes, base64. Encrypts social tokens at rest (AES-256-GCM). Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Public URL of the dashboard (used for links and OAuth redirects). Required in production.
APP_URL=http://localhost:5173

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". Required in production.
CRON_SECRET=

# Use the mock social provider with deterministic sample data (true/false).
SOCIAL_MOCK=true

# Meta (Facebook Page + Instagram professional account) app credentials. Phase 5.
META_APP_ID=
META_APP_SECRET=

# Google OAuth client for YouTube. Phase 5.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn app for company pages (docs/social-providers.md#linkedin). LinkedIn shows
# "Coming soon" until both are set (and SOCIAL_MOCK=false).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: Marketing API version YYYYMM (default 202609; bump it yearly) and OAuth scopes.
LINKEDIN_API_VERSION=
LINKEDIN_SCOPES=

# TikTok app. Phase 5.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X (Twitter) app. Phase 5; needs a paid API plan, confirm cost first.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Local port for `npm run dev` (ignored on Vercel).
PORT=4000

# Optional: a Slack or Discord incoming-webhook URL that receives server errors (free).
ERROR_WEBHOOK_URL=
